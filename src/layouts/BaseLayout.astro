---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { site } from '../site.config';
// Self-hosted fonts (OFL-1.1): no third-party request. Pretendard's dynamic
// subset only downloads the unicode ranges a page actually uses.
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  showSidebar?: boolean;
  /** Keep thin pages (e.g. a tech with no posts yet) out of search results. */
  noindex?: boolean;
}

const { title, description, showSidebar = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const pageDescription = description ?? site.description;
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap.xml" />


</head>
<body>
  <Header />

  <div class="layout">
    <main class="main">
      <slot />
    </main>
    {showSidebar && <Sidebar />}
  </div>

  <Footer />
</body>
</html>
