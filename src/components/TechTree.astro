---
import type { TreeNode } from '../lib/tech';

interface Props {
  nodes: TreeNode[];
  /** Tech id to highlight (the page's own tech). */
  current?: string;
}

const { nodes, current } = Astro.props;
---

<ul class="tech-tree">
  {nodes.map((node) => (
    <li>
      <a
        href={`/tech/${node.tech.id}/`}
        class:list={{ current: node.tech.id === current, empty: node.tech.posts.length === 0 }}
      >{node.tech.name}</a>
      {node.tech.posts.length > 0 && <span class="tech-tree-count">{node.tech.posts.length}</span>}
      {node.repeated && <span class="tech-tree-note">위에 있음</span>}
      {node.children.length > 0 && <Astro.self nodes={node.children} current={current} />}
    </li>
  ))}
</ul>

<style>
  .tech-tree {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
  }
  .tech-tree .tech-tree {
    margin-left: 7px;
    padding-left: 14px;
    border-left: 1px solid var(--color-border, #e2e8f0);
  }
  li {
    position: relative;
    margin: 0;
    padding: 3px 0;
  }
  .tech-tree .tech-tree > li::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 14px;
    width: 10px;
    border-top: 1px solid var(--color-border, #e2e8f0);
  }
  a { color: var(--color-text, #1e293b); }
  a.empty { color: var(--color-text-sub, #64748b); }
  a.current { color: var(--color-primary, #2563eb); font-weight: 700; }
  a:hover { color: var(--color-primary, #2563eb); }
  .tech-tree-count {
    margin-left: 6px;
    font-size: 11px;
    font-weight: 700;
    color: #fff;
    background: var(--color-primary, #2563eb);
    border-radius: 10px;
    padding: 0 6px;
  }
  .tech-tree-note {
    margin-left: 6px;
    font-size: 11px;
    color: var(--color-text-sub, #64748b);
  }
</style>
