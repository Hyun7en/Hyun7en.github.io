---
import type { FlowPath, TechIndex } from '../lib/tech';

interface Props {
  path: FlowPath;
  index: TechIndex;
}

const { path, index } = Astro.props;
const colorOf = (domainId: string) => index.domains.find((d) => d.id === domainId)!.color;
const last = path.steps[path.steps.length - 1];
---

<div class="flow-path card">
  <div class="flow-path-title">{last.name}까지의 흐름 · 글 {path.postCount}편</div>
  <ol class="flow-steps">
    {path.steps.map((tech) => (
      <li>
        <a
          href={`/tech/${tech.id}/`}
          class:list={['flow-step', { empty: tech.posts.length === 0 }]}
          style={`--c: ${colorOf(tech.domain)}`}
        >
          <b>{tech.name}</b>
          <small>{tech.posts.length > 0 ? `글 ${tech.posts.length}편` : '아직 글 없음'}</small>
        </a>
      </li>
    ))}
    {path.upcoming && (
      <li>
        <a
          href={`/tech/${path.upcoming.id}/`}
          class="flow-step empty upcoming"
          style={`--c: ${colorOf(path.upcoming.domain)}`}
        >
          <b>{path.upcoming.name}</b>
          <small>다음 단계</small>
        </a>
      </li>
    )}
  </ol>
</div>
