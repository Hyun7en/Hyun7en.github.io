---
interface DataPoint {
  label: string;
  value: number;
  unit?: string;
}

interface Props {
  title?: string;
  data: DataPoint[];
}

const { title, data } = Astro.props;
const max = Math.max(...data.map((d) => d.value), 1);
---

<div class="benchmark-chart">
  {title && <h4 class="benchmark-chart-title">{title}</h4>}
  <div class="benchmark-chart-bars">
    {data.map((d) => (
      <div class="benchmark-chart-row">
        <span class="benchmark-chart-label">{d.label}</span>
        <div class="benchmark-chart-track">
          <div class="benchmark-chart-bar" style={`width: ${(d.value / max) * 100}%`}></div>
        </div>
        <span class="benchmark-chart-value">{d.value}{d.unit ?? ''}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .benchmark-chart {
    margin: 24px 0;
    padding: 20px 24px;
    background: var(--color-surface, #fff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius, 8px);
    font-family: var(--font-body, sans-serif);
  }

  .benchmark-chart-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text, #1e293b);
    margin-bottom: 16px;
  }

  .benchmark-chart-bars {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .benchmark-chart-row {
    display: grid;
    grid-template-columns: 120px 1fr 56px;
    align-items: center;
    gap: 10px;
  }

  .benchmark-chart-label {
    font-size: 13px;
    color: var(--color-text-sub, #64748b);
  }

  .benchmark-chart-track {
    background: var(--color-bg, #f8fafc);
    border-radius: 4px;
    overflow: hidden;
    height: 10px;
  }

  .benchmark-chart-bar {
    height: 100%;
    background: var(--color-primary, #2563eb);
    border-radius: 4px;
  }

  .benchmark-chart-value {
    font-size: 12px;
    font-family: var(--font-code, monospace);
    color: var(--color-text, #1e293b);
    text-align: right;
  }
</style>
