---
interface DataPoint {
  label: string;
  value: number;
  unit?: string;
}

interface Props {
  title?: string;
  data: DataPoint[];
  /** Whether a smaller value is better (latency, size) or a larger one (throughput). */
  better?: 'lower' | 'higher';
}

const { title, data, better = 'lower' } = Astro.props;
const max = Math.max(...data.map((d) => d.value), 1);
const best = better === 'lower' ? Math.min(...data.map((d) => d.value)) : max;
const ratio = (v: number) => (better === 'lower' ? v / best : best / v);
const rank = (v: number) => (better === 'lower' ? v : -v);
---

<figure class="benchmark-chart" data-benchmark>
  <figcaption>
    {title && <span class="benchmark-chart-title">{title}</span>}
    {data.length > 2 && (
      <span class="benchmark-chart-sort" role="group" aria-label="정렬">
        <button type="button" data-sort="order" aria-pressed="true">입력 순</button>
        <button type="button" data-sort="rank" aria-pressed="false">성능 순</button>
      </span>
    )}
  </figcaption>
  <ol class="benchmark-chart-bars">
    {data.map((d, i) => (
      <li class="benchmark-chart-row" data-order={i} data-rank={rank(d.value)} tabindex="0">
        <span class="benchmark-chart-label">{d.label}</span>
        <span class="benchmark-chart-track">
          <span class="benchmark-chart-bar" style={`width: ${(d.value / max) * 100}%`}></span>
        </span>
        <span class="benchmark-chart-value">
          <span class="benchmark-chart-ratio">
            {ratio(d.value) === 1 ? '최고' : `최고 대비 ${ratio(d.value).toFixed(1)}배`}
          </span>
          {d.value}{d.unit ?? ''}
        </span>
      </li>
    ))}
  </ol>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-benchmark]').forEach((root) => {
    const list = root.querySelector('ol')!;
    root.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((button) => {
      button.addEventListener('click', () => {
        root.querySelectorAll('[data-sort]').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        const key = button.dataset.sort === 'rank' ? 'rank' : 'order';
        [...list.querySelectorAll<HTMLElement>('li')]
          .sort((a, b) => Number(a.dataset[key]) - Number(b.dataset[key]))
          .forEach((li) => list.append(li));
      });
    });
  });
</script>

<style>
  .benchmark-chart {
    margin: 24px 0;
    padding: 20px 24px;
    background: var(--color-surface, #fff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius, 8px);
    font-family: var(--font-body, sans-serif);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .benchmark-chart-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text, #1e293b);
  }

  .benchmark-chart-sort button {
    font: inherit;
    font-size: 12px;
    padding: 3px 10px;
    border: 1px solid var(--color-border, #e2e8f0);
    background: var(--color-surface, #fff);
    color: var(--color-text-sub, #64748b);
    border-radius: 6px;
    cursor: pointer;
  }
  .benchmark-chart-sort button[aria-pressed='true'] {
    background: var(--color-primary-solid, #2563eb);
    border-color: var(--color-primary-solid, #2563eb);
    color: #fff;
  }

  .benchmark-chart-bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .benchmark-chart-row {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    align-items: center;
    gap: 10px;
    margin: 0;
  }

  .benchmark-chart-label {
    font-size: 13px;
    color: var(--color-text-sub, #64748b);
  }

  .benchmark-chart-track {
    background: var(--color-bg, #f8fafc);
    border-radius: 4px;
    overflow: hidden;
    height: 10px;
  }

  .benchmark-chart-bar {
    display: block;
    height: 100%;
    background: var(--color-primary, #2563eb);
    border-radius: 4px;
  }

  .benchmark-chart-value {
    min-width: 56px;
    font-size: 12px;
    font-family: var(--font-code, monospace);
    color: var(--color-text, #1e293b);
    text-align: right;
    white-space: nowrap;
  }

  /* Shown on hover/focus beside the value, so it never covers another row. */
  .benchmark-chart-ratio {
    display: none;
    margin-right: 6px;
    font-family: var(--font-body, sans-serif);
    font-size: 11px;
    color: var(--color-text-sub, #64748b);
  }
  .benchmark-chart-row:hover .benchmark-chart-ratio,
  .benchmark-chart-row:focus .benchmark-chart-ratio { display: inline; }
  .benchmark-chart-row:hover .benchmark-chart-bar,
  .benchmark-chart-row:focus .benchmark-chart-bar { background: var(--color-primary-h, #1d4ed8); }

  @media (max-width: 480px) {
    .benchmark-chart { padding: 16px; }
    .benchmark-chart-row { grid-template-columns: 90px 1fr auto; }
  }
</style>
