---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DomainBadge from '../../components/DomainBadge.astro';
import TechChip from '../../components/TechChip.astro';
import TechTree from '../../components/TechTree.astro';
import { formatDate, formatDateLong } from '../../lib/format';
import { getTechIndex, techTree, type PostSummary, type Tech } from '../../lib/tech';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// utterances reads custom attributes that the <script> element type doesn't declare.
const utterances = { repo: 'Hyun7en/Hyun7en.github.io', 'issue-term': 'pathname', theme: 'github-light' };

const words = post.body?.split(/\s+/).length ?? 0;
const readTime = Math.floor(words / 200) + 1;

const index = await getTechIndex();
const domainById = new Map(index.domains.map((d) => [d.id, d]));
const techs = post.data.tech.map((id) => index.techs.get(id)!);
const primary = techs[0];
const domain = primary ? domainById.get(primary.domain) : undefined;
// What the post's main tech builds on, so readers see where this post sits.
const prerequisites = primary ? techTree(index, primary.id, 'requires').children : [];
const prerequisiteCount = new Set(
  (function collect(nodes): string[] {
    return nodes.flatMap((n) => [n.tech.id, ...collect(n.children)]);
  })(prerequisites)
).size;

// "Read next" follows the tech flow instead of publish date.
const seen = new Set([post.id]);
const flowNext: { from: Tech; to: Tech; post: PostSummary }[] = [];
for (const tech of techs) {
  for (const nextId of tech.next) {
    const to = index.techs.get(nextId)!;
    for (const p of to.posts) {
      if (seen.has(p.id)) continue;
      seen.add(p.id);
      flowNext.push({ from: tech, to, post: p });
    }
  }
}
const sameTech = techs
  .flatMap((t) => t.posts)
  .filter((p) => !seen.has(p.id) && seen.add(p.id))
  .slice(0, 4);
const nextTechs = [...new Set(techs.flatMap((t) => t.next))]
  .map((id) => index.techs.get(id)!)
  .filter((t) => !post.data.tech.includes(t.id));
---

<BaseLayout title={post.data.title} description={post.data.description} showSidebar>
  <article class="post-article">
    <header class="post-header">
      {prerequisites.length > 0 && (
        <details class="post-trail">
          <summary>
            <b>{primary.name}</b> 전에 알아야 할 기술 {prerequisiteCount}개
          </summary>
          <div class="post-trail-tree">
            <TechTree nodes={prerequisites} />
          </div>
        </details>
      )}

      {domain && <DomainBadge domain={domain} />}

      <h1 class="post-title">{post.data.title}</h1>

      <div class="post-meta">
        <span class="post-meta-item">📅 {formatDateLong(post.data.date)}</span>
        <span class="post-meta-item">⏱ 약 {readTime}분</span>
      </div>

      {techs.length > 0 && (
        <div class="post-tags">
          {techs.map((tech) => <TechChip tech={tech} domain={domainById.get(tech.domain)!} />)}
        </div>
      )}
    </header>

    <div class="post-content">
      <Content />
    </div>
  </article>

  {techs.length > 0 && (
    <section class="card read-next">
      <h2 class="section-title">이어서 읽기</h2>

      {flowNext.length > 0 && (
        <ul class="link-list">
          {flowNext.map(({ from, to, post: p }) => (
            <li>
              <span class="read-next-flow">{from.name} → {to.name}</span>
              <a href={`/posts/${p.id}/`}>{p.title}</a>
              <small>{formatDate(p.date)}</small>
            </li>
          ))}
        </ul>
      )}

      {sameTech.length > 0 && (
        <>
          <h3 class="read-next-sub">같은 기술을 다룬 글</h3>
          <ul class="link-list">
            {sameTech.map((p) => (
              <li>
                <a href={`/posts/${p.id}/`}>{p.title}</a>
                <small>{formatDate(p.date)}</small>
              </li>
            ))}
          </ul>
        </>
      )}

      {nextTechs.length > 0 && (
        <>
          <h3 class="read-next-sub">다음으로 이어지는 기술</h3>
          <div>{nextTechs.map((t) => <TechChip tech={t} domain={domainById.get(t.domain)!} />)}</div>
        </>
      )}

      {flowNext.length === 0 && sameTech.length === 0 && nextTechs.length === 0 && (
        <p class="muted"><a href="/tech/">로드맵</a>에서 다른 기술의 흐름을 둘러보세요.</p>
      )}
    </section>
  )}

  <div class="comments" style="margin-top: 36px;">
    <script is:inline src="https://utteranc.es/client.js" crossorigin="anonymous" async {...utterances}></script>
  </div>
</BaseLayout>
