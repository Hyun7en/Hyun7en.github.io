---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NodeDetailPanel from '../../components/NodeDetailPanel';
import { getGraph } from '../../lib/graph';

export async function getStaticPaths() {
  const { getGraph } = await import('../../lib/graph');
  const graph = await getGraph();
  return graph.nodes.map((n) => ({ params: { id: n.id } }));
}

const graph = await getGraph();
const nodesById = Object.fromEntries(graph.nodes.map((n) => [n.id, { id: n.id, name: n.name }]));

const { id } = Astro.params;
const node = graph.nodes.find((n) => n.id === id) ?? null;
---

<BaseLayout title={node?.name ?? 'Architecture'}>
  {node ? (
    <NodeDetailPanel node={node} nodesById={nodesById} />
  ) : (
    <p>노드를 찾을 수 없습니다.</p>
  )}
  <p style="margin-top: 20px;"><a href="/">← Architecture 그래프로 돌아가기</a></p>
</BaseLayout>
