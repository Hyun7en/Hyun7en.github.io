---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTechIndex, type Tech } from '../../lib/tech';

export async function getStaticPaths() {
  const index = await getTechIndex();
  return index.tracks.map((track) => ({ params: { id: track.id } }));
}

const index = await getTechIndex();
const track = index.tracks.find((t) => t.id === Astro.params.id)!;
const colorOf = (tech: Tech) => index.domains.find((d) => d.id === tech.domain)!.color;
const covered = track.techs.filter((t) => t.posts.length > 0).length;
---

<BaseLayout title={track.name} description={track.description}>
  <header class="track-header">
    <a href="/tech/" class="muted">← 로드맵</a>
    <h1 class="page-title">{track.name}</h1>
    {track.description && <p class="page-lead">{track.description}</p>}
    <div class="track-progress">
      <span class="progress-bar"><i style={`width: ${(covered / track.techs.length) * 100}%`}></i></span>
      <span class="muted">글 있는 기술 {covered} / {track.techs.length}</span>
    </div>
    <ul class="track-legend muted">
      <li><span class="legend-solid"></span>글 있음</li>
      <li><span class="legend-dashed"></span>아직 글 없음</li>
      <li><span class="legend-pick">택1</span>하나만 골라도 됨</li>
      <li><span class="legend-branch"></span>함께 보면 좋은 기술</li>
    </ul>
  </header>

  <ol class="track-spine">
    {track.steps.map((step, i) => (
      <li class:list={['track-step', i % 2 === 0 ? 'branches-right' : 'branches-left']}>
        <div class="track-main">
          <span class="track-step-no">{i + 1}</span>
          {step.options.length > 1 && <span class="track-pick-label">택1</span>}
          <div class="track-options">
            {step.options.map((tech) => (
              <a
                href={`/tech/${tech.id}/`}
                class:list={['track-node', { empty: tech.posts.length === 0 }]}
                style={`--c: ${colorOf(tech)}`}
              >
                {tech.name}
                {tech.posts.length > 0 && <span class="track-count">{tech.posts.length}</span>}
              </a>
            ))}
          </div>
        </div>
        {step.branches.length > 0 && (
          <div class="track-branches">
            {step.branches.map((tech) => (
              <a
                href={`/tech/${tech.id}/`}
                class:list={['track-branch', { empty: tech.posts.length === 0 }]}
                style={`--c: ${colorOf(tech)}`}
              >
                {tech.name}
                {tech.posts.length > 0 && <span class="track-count">{tech.posts.length}</span>}
              </a>
            ))}
          </div>
        )}
      </li>
    ))}
  </ol>
</BaseLayout>
